# ── Deploy ─────────────────────────────────────────────────────────────────────
# Public domain (or IP) served by Caddy. Leave blank for localhost (self-signed cert).
DOMAIN=notes.example.com

# Docker Hub images (set these if you use your own fork / private registry)
DOCKERHUB_BACKEND_IMAGE=anxdeveloper/note-taker-backend
DOCKERHUB_FRONTEND_IMAGE=anxdeveloper/note-taker-frontend
IMAGE_TAG=latest

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
BACKEND_RELOAD=false

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, good for single-server VPS):
NOTES_DB_URL=sqlite+aiosqlite:///data/notes.db
# PostgreSQL (swap in when scaling):
# NOTES_DB_URL=postgresql+asyncpg://user:password@host:5432/notes

# ── Audio storage ──────────────────────────────────────────────────────────────
NOTES_AUDIO_DIR=data/audio
NOTES_AUDIO_RETENTION_DAYS=30

# ── Auth (static token for v1) ─────────────────────────────────────────────────
NOTES_API_TOKEN=change-me-to-a-strong-random-token

# ── AI Classifier ──────────────────────────────────────────────────────────────
# Provider: anthropic | openai | null (null disables classification)
AI_PROVIDER=null
AI_CLASSIFIER_ENABLED=true
# Leave empty to use the provider default (haiku for anthropic, gpt-4o-mini for openai)
AI_CLASSIFIER_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Whisper STT ────────────────────────────────────────────────────────────────
# Models: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# Language: auto | es | en | ...
WHISPER_LANGUAGE=auto
